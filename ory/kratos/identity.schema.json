{
  "$id": "https://weaveauth.local/identity.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WeaveAuth identity",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "title": "Email",
          "minLength": 3,
          "ory.sh/kratos": {
            "credentials": {
              "password": { "identifier": true },
              "passkey": { "display_name": true }
            },
            "verification": { "via": "email" },
            "recovery": { "via": "email" }
          }
        },
        "first_name": {
          "type": "string",
          "title": "First name",
          "minLength": 1,
          "maxLength": 100
        },
        "last_name": {
          "type": "string",
          "title": "Last name",
          "minLength": 1,
          "maxLength": 100
        },
        "phone_number": {
          "type": "string",
          "title": "Phone number (e.g. +46701234567)",
          "pattern": "^\\+[1-9][0-9]{6,14}$"
        }
      },
      "required": ["email", "first_name", "last_name"],
      "additionalProperties": false
    }
  }
}

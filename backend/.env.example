# Copy to .env (git-ignored) and fill in real values for local development.
# See backend/config.yaml for the corresponding oidc_providers.google block.
WA_OIDC_GOOGLE_CLIENT_ID=
WA_OIDC_GOOGLE_CLIENT_SECRET=

# Anything named WA_PLUGIN_<PLUGIN>_ENV_<NAME> is forwarded to that plugin
# process as <NAME>, with the prefix stripped. The extra-data plugin is
# REGISTRATION -- see docs/plugins.md.
#WA_PLUGIN_REGISTRATION_ENV_DATABASE_URL=
